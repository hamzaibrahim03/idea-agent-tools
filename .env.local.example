# Copy this file to .env.local and fill in your real keys for local
# testing of the /api serverless functions with `npm run dev:vercel`.
# .env.local is gitignored - never commit real keys.
#
# These are read server-side only by api/generate-prompt.js and
# api/agent.js via process.env - never hardcoded, never bundled into
# client JS.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
